<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot: versión estable
        Maneja dependencias, versión de Java y configuración básica del proyecto.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.12</version>
        <relativePath/>
    </parent>

    <!--
        Datos básicos del proyecto.
        - groupId = tu organización
        - artifactId = nombre del proyecto
    -->
    <groupId>com.utez.EquipoValeriaLuis</groupId>
    <artifactId>Contactos</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Contactos</name>
    <description>Aplicación para gestión de contactos con validación y eliminación.</description>

    <!-- Versión de Java -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <!--
        DEPENDENCIAS
        Todo lo que tu proyecto necesita para funcionar
    -->
    <dependencies>

        <!--
            Spring Web:
            Permite crear controladores, endpoints REST, y manejar peticiones HTTP.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            JPA:
            Se encarga de guardar, listar, actualizar y eliminar datos en la BD.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Validation:
            Permite validar datos (como que el nombre o teléfono NO vayan vacíos).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            H2 Database:
            Una base de datos ligera en memoria.
            Perfecta para practicar y para proyectos escolares.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Tests (no los vas a usar pero Spring los pide por defecto)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!--
        Plugin que permite ejecutar el proyecto con:
        mvn spring-boot:run
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
